class Solution {
public:
    bool arraySortedOrNot(int arr[], int n) {
    
        int flag=0;
        if(n==1)
            return true;
        for(int i=0;i<n-1;i++)
        {
            if(arr[i]>arr[i+1])
            {
                flag=0;
                break;
            }
            else
                flag=1;
        }
        if(flag==1)
            return true;
        else
            return false;

    }
};
