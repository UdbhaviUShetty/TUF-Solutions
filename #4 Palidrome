class Solution {
public:
    bool isPalindrome(int n) {
        int digit=n;
        int rev=0;
        while(n>0)
        {
            int last=n%10;
            rev=rev*10+last;
            n=n/10;
        }
        if(rev==digit)
            return true;
        else 
            return false;

    }
};
